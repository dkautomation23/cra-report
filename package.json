{
  "name": "cra-report",
  "version": "0.1.0",
  "description": "Find the components you ship that are being exploited in the wild, and draft the EU Cyber Resilience Act Article 14 notification for them.",
  "type": "module",
  "bin": {
    "cra-report": "dist/src/main.js"
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "start": "node dist/src/main.js"
  },
  "keywords": [
    "cra",
    "cyber-resilience-act",
    "sbom",
    "kev",
    "vulnerability",
    "compliance",
    "enisa",
    "supply-chain",
    "cli"
  ],
  "license": "MIT",
  "author": "Dmytro Galko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dkautomation23/cra-report.git"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
